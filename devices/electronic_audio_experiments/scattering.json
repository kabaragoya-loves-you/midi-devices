  "x_pc": {
    "indexBase": 0,
    "count": 17,
    "bankSelectMode": "none",
    "additionalInfo": "PC 0 = panel / manual mode (last front-panel state). PC 1–3 front-panel presets; PC 4–16 MIDI-only. Save: hold Preset until blink, then PC; or send PC = slot+64 (e.g. PC 68 saves slot 4). Taxonomy note: PC 0 is not a stored preset — count 17 is a workaround to expose it."
  },
  "x_midiTrs": "TYPE_A",
  "x_midiChannel": 2,
  "additionalInfo": "EAE Scattering manual §4 / Appendix A Table 1. CTRL jack Tip Active MIDI (ring unused). Default ch 2; hold Aux at power-up, send PC on desired channel. 14-bit via MSB/LSB pairs — MSB alone is fine. Notes: C(−1)–C3 pitch→Space; C4–C8 Morph; C9 LFO reset. Velocity ignored."
