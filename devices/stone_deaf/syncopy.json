  "device": {
    "displayName": "",
    "manufacturer": "Stone Deaf Effects",
    "model": "Syncopy",
    "version": ""
  },
  "receives": [
    "PROGRAM_CHANGE",
    "CLOCK"
  ],
  "transmits": [],
  "controlChangeCommands": [
    {
      "controlChangeNumber": 20,
      "name": "Delay Time",
      "valueRange": { "min": 0, "max": 127 },
      "additionalInfo": "0 = min, 127 = max."
    },
    {
      "controlChangeNumber": 21,
      "name": "Feedback",
      "valueRange": { "min": 0, "max": 127 },
      "additionalInfo": "0 = min, 127 = max."
    },
    {
      "controlChangeNumber": 22,
      "name": "Mix",
      "valueRange": { "min": 0, "max": 127 },
      "additionalInfo": "127 = wet, 63 = 50/50, 0 = dry."
    },
    {
      "controlChangeNumber": 23,
      "name": "Mod On/Off",
      "valueRange": {
        "min": 0,
        "max": 127,
        "discreteValues": [
          { "name": "Off", "value": 0 },
          { "name": "On", "value": 127 }
        ]
      },
      "additionalInfo": "Left-page function is Modulation ON/OFF. Facing-page description wrongly reprints Delay Time (CC20) — table row / function name wins."
    },
    {
      "controlChangeNumber": 24,
      "name": "Mod Time",
      "valueRange": { "min": 0, "max": 127 },
      "additionalInfo": "0 = min, 127 = max."
    },
    {
      "controlChangeNumber": 25,
      "name": "Mod Depth",
      "valueRange": { "min": 0, "max": 127 },
      "additionalInfo": "0 = min, 127 = max."
    },
    {
      "controlChangeNumber": 26,
      "name": "Mod Shape",
      "valueRange": {
        "min": 0,
        "max": 127,
        "discreteValues": [
          { "name": "Shape 1", "value": 7 },
          { "name": "Shape 2", "value": 21 },
          { "name": "Shape 3", "value": 35 },
          { "name": "Shape 4", "value": 49 },
          { "name": "Shape 5", "value": 63 },
          { "name": "Shape 6", "value": 77 },
          { "name": "Shape 7", "value": 91 },
          { "name": "Shape 8", "value": 105 },
          { "name": "Shape 9", "value": 120 }
        ]
      },
      "additionalInfo": "0–14 / 15–28 / 29–42 / 43–56 / 57–70 / 71–84 / 85–98 / 99–112 / 113–127."
    },
    {
      "controlChangeNumber": 27,
      "name": "Tap Div",
      "valueRange": {
        "min": 0,
        "max": 127,
        "discreteValues": [
          { "name": "1/4", "value": 12 },
          { "name": "Dot 1/8", "value": 37 },
          { "name": "1/8", "value": 62 },
          { "name": "Triplet", "value": 87 },
          { "name": "1/16", "value": 113 }
        ]
      },
      "additionalInfo": "0–24 crotchet; 25–49 dotted quaver; 50–74 quaver; 75–99 triplet; 100–127 semi-quaver."
    },
    {
      "controlChangeNumber": 29,
      "name": "Bypass",
      "valueRange": {
        "min": 0,
        "max": 127,
        "discreteValues": [
          { "name": "Bypass", "value": 0 },
          { "name": "Engaged", "value": 127 }
        ]
      },
      "additionalInfo": "Below 64 = bypass. Above 63 = engaged (manual says “OFF” — same Stone Deaf wording error as other products; treated as ON)."
    },
    {
      "controlChangeNumber": 30,
      "name": "MIDI Clock",
      "valueRange": {
        "min": 0,
        "max": 127,
        "discreteValues": [
          { "name": "Off", "value": 0 },
          { "name": "On", "value": 127 }
        ]
      },
      "additionalInfo": "Below 64 = Beat Clock Off; above 63 = On. When on, clock overrides Rate."
    },
    {
      "controlChangeNumber": 93,
      "name": "Remote Tap",
      "valueRange": {
        "min": 0,
        "max": 127,
        "discreteValues": [
          { "name": "Tap", "value": 1 }
        ]
      },
      "additionalInfo": "Any value = tap-tempo press."
    }
  ],
  "x_pc": {
    "indexBase": 0,
    "count": 128,
    "bankSelectMode": "none",
    "additionalInfo": "PC 0–127. Footswitch banks of 4; selecting a preset via MIDI sets the bank for footswitch cycling (manual says “channel” but means preset number)."
  },
  "x_midiTrs": "TYPE_A",
  "x_midiChannel": 1,
  "additionalInfo": "Stone Deaf Syncopy MIDI Guide (pp. 8–17), reconstructed from split facing pages. Hold Bypass 5s while bypassed for setup: Feedback sets MIDI channel 1–16; Mix toggles Beat Clock (green=on, red=off). Factory map: CC20–27, 29–30, 93. Tone and Level knobs have no MIDI CCs. No CC28."
}
